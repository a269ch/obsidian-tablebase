{
  "name": "obsidian-tablebase",
  "version": "0.1.1",
  "description": "Turn standard Markdown tables into interactive Notion-like databases: Kanban board view, multi-select tags, date pickers, calculations, and advanced filters",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tables",
    "tablebase",
    "kanban",
    "database",
    "multi-select",
    "filters",
    "calculations"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/a269ch/obsidian-tablebase.git"
  },
  "bugs": {
    "url": "https://github.com/a269ch/obsidian-tablebase/issues"
  },
  "homepage": "https://github.com/a269ch/obsidian-tablebase#readme",
  "author": "Aleksei Chekodanov",
  "license": "MIT",
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "obsidian": "^1.7.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
